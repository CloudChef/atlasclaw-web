---
import LocaleSwitch from "./LocaleSwitch.astro";

const { lang, pathname, content } = Astro.props;

const links = [
  { key: "home", href: `/${lang}/` },
  { key: "architecture", href: `/${lang}/architecture/` },
  { key: "integrations", href: `/${lang}/integrations/` },
  { key: "embedded", href: `/${lang}/embedded-agent/` },
  { key: "releases", href: `/${lang}/releases/` },
  { key: "docs", href: `/${lang}/docs/` }
];

function isActive(href) {
  if (href === `/${lang}/`) {
    return pathname === href;
  }
  return pathname.startsWith(href);
}
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="brand-mark" href={`/${lang}/`}>
      <span class="brand-mark__glyph">
        <img
          class="brand-mark__icon"
          src="/images/brand/atlasclaw-icon.png"
          alt=""
          width="394"
          height="367"
        />
      </span>
      <span class="brand-mark__text">
        <strong>AtlasClaw</strong>
        <small>{content.common.builtFor}</small>
      </span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      {
        links.map((link) => (
          <a
            class:list={[
              "site-nav__link",
              link.key === "embedded" && "site-nav__link--featured",
              isActive(link.href) && "is-active"
            ]}
            href={link.href}
          >
            {content.nav[link.key]}
          </a>
        ))
      }
    </nav>

    <div class="site-header__actions">
      <LocaleSwitch lang={lang} pathname={pathname} />
      <a
        class="github-link"
        href="https://github.com/CloudChef/atlasclaw"
        aria-label={content.nav.github}
        title={content.nav.github}
      >
        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path
            fill="currentColor"
            d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38
            0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52
            -.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.5-1.07-1.78-.2
            -3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82A7.66
            7.66 0 0 1 8 4.76a7.66 7.66 0 0 1 2.01.27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08
            2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48
            0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          />
        </svg>
        <span class="sr-only">{content.nav.github}</span>
      </a>
    </div>
  </div>
</header>
