---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SectionHeading from "../../../components/SectionHeading.astro";
import FeatureGrid from "../../../components/FeatureGrid.astro";
import CodeBlock from "../../../components/CodeBlock.astro";
import { siteContent } from "../../../content/site.js";
import { locales } from "../../../lib/i18n.js";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const content = siteContent[lang];
---

<BaseLayout
  lang={lang}
  title={content.deployment.title}
  description={content.deployment.description}
  pathname={`/${lang}/docs/deployment/`}
  theme="light"
>
  <section class="shell page-hero page-hero--light">
    <span class="eyebrow">{lang === "zh" ? "部署" : "Deployment"}</span>
    <h1>{lang === "zh" ? "选定部署形态，再接入 Provider。" : "Choose the deployment shape, then wire providers."}</h1>
    <p>{content.deployment.intro}</p>
  </section>

  <section class="shell section">
    <SectionHeading
      eyebrow={lang === "zh" ? "模式" : "Modes"}
      title={lang === "zh" ? "嵌入式与独立式。" : "Embedded and standalone."}
    />
    <FeatureGrid items={content.deployment.modes} compact={true} />
  </section>

  <section class="shell section">
    <SectionHeading
      eyebrow={lang === "zh" ? "配置基础" : "Configuration basics"}
      title={lang === "zh" ? "运行时围绕 providers_root 组织。" : "The runtime is anchored around providers_root."}
    />
    <CodeBlock code={content.deployment.config} />
  </section>

  <section class="shell section section--split">
    <div>
      <SectionHeading
        eyebrow={lang === "zh" ? "操作建议" : "Operational notes"}
        title={lang === "zh" ? "保留治理边界。" : "Preserve governance boundaries."}
      />
      <ul class="signal-list signal-list--light">
        {content.deployment.notes.map((item) => <li>{item}</li>)}
      </ul>
    </div>
    <div>
      <SectionHeading title={content.common.deepReference} />
      <div class="link-list">
        {content.deployment.references.map((item) => (
          <a class="text-link" href={item.href}>{item.label}</a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
