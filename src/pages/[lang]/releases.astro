---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import CTASection from "../../components/CTASection.astro";
import { siteContent } from "../../content/site.js";
import { locales } from "../../lib/i18n.js";
import { absoluteUrl } from "../../lib/seo.js";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const content = siteContent[lang];
const releases = content.releases;
const structuredArticles = releases.items.map((release) => ({
  headline: `${release.version}: ${release.title}`,
  description: release.summary,
  datePublished: release.dateIso,
  url: absoluteUrl(`/${lang}/releases/#${release.id}`),
  keywords: release.keywords
}));
---

<BaseLayout
  lang={lang}
  title={releases.title}
  description={releases.description}
  pathname={`/${lang}/releases/`}
  keywords={releases.keywords}
  structuredArticles={structuredArticles}
  theme="light"
>
  <section class="shell page-hero release-hero">
    <span class="eyebrow">{releases.hero.eyebrow}</span>
    <h1>{releases.hero.title}</h1>
    <p>{releases.hero.description}</p>
    <div class="release-hero__stats" aria-label={releases.statsLabel}>
      {
        releases.stats.map((item) => (
          <article class="release-stat">
            <strong>{item.value}</strong>
            <span>{item.label}</span>
            <p>{item.detail}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="shell section">
    <SectionHeading
      eyebrow={releases.index.eyebrow}
      title={releases.index.title}
      description={releases.index.description}
    />
    <div class="release-index-grid">
      {
        releases.items.map((release) => (
          <a class="release-index-card" href={`#${release.id}`}>
            <time class="release-index-card__date" datetime={release.dateIso}>
              {release.date}
            </time>
            <strong>{release.version}</strong>
            <h3>{release.title}</h3>
            <p>{release.summary}</p>
            <span class="release-index-card__action">{releases.index.actionLabel}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="shell section release-timeline" aria-label={releases.timelineLabel}>
    {
      releases.items.map((release) => (
        <article class="release-card" id={release.id}>
          <div class="release-card__rail" aria-hidden="true">
            <span>{release.version}</span>
          </div>
          <div class="release-card__content">
            <header class="release-card__header">
              <div>
                <time class="release-card__date" datetime={release.dateIso}>
                  {release.date}
                </time>
                <h2>{release.title}</h2>
                <p>{release.lede}</p>
              </div>
              <div class="release-card__tags" aria-label={releases.tagsLabel}>
                {release.tags.map((tag) => <span>{tag}</span>)}
              </div>
            </header>

            <div class="release-highlight-grid">
              {
                release.highlights.map((highlight) => (
                  <article class="release-highlight">
                    <strong>{highlight.title}</strong>
                    <p>{highlight.description}</p>
                  </article>
                ))
              }
            </div>

            {
              release.milestones && (
                <div class="release-milestones" aria-label={releases.milestonesLabel}>
                  {release.milestones.map((milestone) => (
                    <div class="release-milestone">
                      <strong>{milestone.range}</strong>
                      <span>{milestone.focus}</span>
                    </div>
                  ))}
                </div>
              )
            }

            <div class="release-section-list">
              {
                release.sections.map((section) => (
                  <section class="release-detail-section">
                    <span class="release-detail-section__eyebrow">{section.eyebrow}</span>
                    <h3>{section.title}</h3>
                    {section.body.map((paragraph) => <p>{paragraph}</p>)}
                    <ul class="signal-list">
                      {section.points.map((point) => <li>{point}</li>)}
                    </ul>
                  </section>
                ))
              }
            </div>

            <footer class="release-card__footer">
              {
                release.links.map((link) => (
                  <a class="text-link" href={link.href}>
                    {link.label}
                  </a>
                ))
              }
            </footer>
          </div>
        </article>
      ))
    }
  </section>

  <CTASection
    eyebrow={releases.cta.eyebrow}
    title={releases.cta.title}
    description={releases.cta.description}
    href={releases.cta.href}
    label={releases.cta.label}
    secondaryHref={releases.cta.secondaryHref}
    secondaryLabel={releases.cta.secondaryLabel}
  />
</BaseLayout>
