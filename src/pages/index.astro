<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AtlasClaw</title>
    <meta name="robots" content="index,follow" />
    <meta http-equiv="refresh" content="0;url=/en/" />
  </head>
  <body style="font-family: 'IBM Plex Sans', sans-serif; padding: 2rem; background: #fbfaf6; color: #343539;">
    <script>
      const language = navigator.language || navigator.userLanguage || "en";
      const target = language.toLowerCase().startsWith("zh") ? "/zh/" : "/en/";
      window.location.replace(target);
    </script>
    <p>Redirecting to AtlasClaw...</p>
    <p>
      <a href="/en/" style="color: #4d8b79;">English</a>
      <span> / </span>
      <a href="/zh/" style="color: #4d8b79;">中文</a>
    </p>
  </body>
</html>
